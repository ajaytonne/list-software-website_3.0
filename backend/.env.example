PORT=3000
# Send lead notifications by email (optional; leads are always saved to data/leads.jsonl)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=bankingsales@listspl.co.in
MAIL_FROM="LIST Website <no-reply@listspl.co.in>"
# Token required to download leads from /api/admin/leads (send as header x-admin-token)
ADMIN_TOKEN=change-me-to-a-long-random-string

# Chatbot AI mode (optional). Without a key, the chatbot still answers from its built-in company knowledge.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Durable lead copy: URL of a Google Apps Script web app that appends each lead as a sheet row (optional)
SHEET_WEBHOOK_URL=
# Where career applications are emailed (defaults to MAIL_TO)
HR_MAIL_TO=
